# Logs de auditoría e idempotencia (datos fiscales)
.biller/

# Stores locales con datos del negocio.
# `data/` es donde apuntan por defecto BILLER_IDEMPOTENCY_LOG_PATH y
# BILLER_BORRADOR_STORE_PATH. El de borradores guarda el CONTENIDO de lo que se
# está por facturar —qué se vendió, a quién, la adenda—: eso no va a un repo.
data/
*.jsonl
!evals/*.jsonl

# Skills de terceros: se restauran con `npx skills add` desde skills-lock.json,
# que SÍ se versiona (mismo criterio que package-lock vs node_modules). El
# contenido vendorizado no entra al repo: no lo escribimos nosotros y no lo
# revisamos en cada diff.
.agents/
.claude/skills/
.claude/settings.local.json

# Extracción analítica: es la contabilidad de la empresa en claro.
# La escribe `scripts/exportar-analitica.mjs` con permisos 0600.
analitica-*.json
analitica-*.html
